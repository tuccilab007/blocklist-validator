# Copie este arquivo para ".env" e preencha os valores.
# O ".env" NUNCA vai para o GitHub (está no .gitignore).

# --- Banco de dados do validador ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=blocklist_demo
DB_USER=
DB_PASSWORD=

# --- Aplicação web (formulário) ---
APP_URL=http://127.0.0.1:5000

# --- Logs ---
LOG_LEVEL=INFO